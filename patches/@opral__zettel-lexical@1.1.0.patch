 import { assertDocument, } from "@opral/zettel-ast";
 import { createDocument } from "./types.js";
 import { createLexicalNode, exportBlockNode, createNodeRegistry, } from "./nodes/index.js";
@@ -87,8 +87,14 @@ export function loadDocument(editor, document, registry) {
     editor.update(() => {
         const nodes = document.blocks.map((block) => createLexicalNode(block, nodeRegistry));
         const root = $getRoot();
+        // Clearing the root under the caret moves the selection onto the root
+        // itself. Typing there makes Lexical create a core ParagraphNode next
+        // to the Zettel blocks, so keep the caret in the new document instead.
+        const hadSelection = $getSelection() !== null;
         root.clear();
         root.append(...nodes);
+        if (hadSelection && nodes.length)
+            root.selectStart();
     }, { discrete: true });
 }
