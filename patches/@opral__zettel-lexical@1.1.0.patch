+import { mergeRegister } from "@lexical/utils";
+import {
+  ZettelCodeNode,
+  ZettelListItemNode,
+  ZettelListNode,
+  ZettelQuoteNode,
+  ZettelSpanNode,
+  ZettelTableCellNode,
